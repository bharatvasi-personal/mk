# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
TZ=Asia/Kolkata

# ─── Database ────────────────────────────────────────────────────────────────
# The APPLICATION role. Must NOT be superuser and must NOT have BYPASSRLS —
# row-level security is what enforces tenant isolation.
DATABASE_URL=postgresql://mk_app:mk_app_dev_password@localhost:5432/mithilakitchen?schema=public
# Privileged role used ONLY by `prisma migrate`.
DATABASE_MIGRATION_URL=postgresql://mk_owner:mk_owner_dev_password@localhost:5432/mithilakitchen?schema=public
# A SEPARATE, throwaway database for `prisma migrate diff` and `migrate dev`.
# Prisma RESETS whatever this points at. Pointing it at the real database drops the data.
SHADOW_DATABASE_URL=postgresql://mk_owner:mk_owner_dev_password@localhost:5432/mithilakitchen_shadow?schema=public
POSTGRES_DB=mithilakitchen
POSTGRES_USER=mk_owner
POSTGRES_PASSWORD=mk_owner_dev_password
POSTGRES_APP_PASSWORD=mk_app_dev_password

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API ─────────────────────────────────────────────────────────────────────
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ─── Auth ────────────────────────────────────────────────────────────────────
# RS256 keypair. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.key
#   openssl rsa -in jwt.key -pubout -out jwt.pub
# Store as single-line with literal \n, or point at a file path.
JWT_PRIVATE_KEY_PATH=./secrets/jwt.key
JWT_PUBLIC_KEY_PATH=./secrets/jwt.pub
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# 32-byte base64 key for envelope-encrypting legal documents and TOTP secrets.
# Generate: openssl rand -base64 32
MASTER_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32

# ─── Payments (Razorpay) ─────────────────────────────────────────────────────
# Leave PAYMENTS_ONLINE_ENABLED=false until Razorpay activation completes.
# Flipping it to true is the only change needed to go live with online payments.
PAYMENTS_ONLINE_ENABLED=false
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Object storage (S3-compatible: MinIO / Backblaze B2 / Cloudflare R2) ────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mithilakitchen
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ─── Notifications ───────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MithilaKitchen <no-reply@mithilakitchen.in>"
# MSG91 for customer login OTP (cheapest reliable Indian SMS).
MSG91_AUTH_KEY=
MSG91_SENDER_ID=MTHLKT
MSG91_OTP_TEMPLATE_ID=
# Leave blank in dev — OTPs are printed to the API log instead of sent.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ─── Web (Next.js) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_DEFAULT_TENANT=mithilakitchen
# The public origin. Open Graph share cards and the sitemap are resolved against this —
# leave it wrong and WhatsApp previews point at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=MithilaKitchen

# ─── Seed (development only) ─────────────────────────────────────────────────
SEED_OWNER_EMAIL=owner@mithilakitchen.in
SEED_OWNER_PASSWORD=ChangeMe@12345
