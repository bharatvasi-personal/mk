# Caddy terminates TLS with automatic Let's Encrypt certificates and renewals —
# one line of configuration instead of a certbot cron job that breaks in year two.

{
	email ops@{$DOMAIN}
	servers {
		trusted_proxies static private_ranges
	}
}

{$DOMAIN}, www.{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(self), microphone=()"
		-Server
	}

	# A request id is generated here and flows through the API logs, so a number read
	# off an error screen can be found in the logs.
	request_header X-Request-Id {http.request.uuid}

	handle /api/* {
		reverse_proxy api:4000 {
			health_uri /api/health/ready
			health_interval 30s
		}
	}

	# Next.js build assets are immutable and content-hashed.
	handle /_next/static/* {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy web:3000
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 10
		}
		format json
	}
}
